generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum StatusOS {
  INICIAL
  ORCAMENTO
  AUTORIZADO
  EM_ANDAMENTO
  CANCELADO
  FINALIZADO
}

// Módulo 4 (parte 2) — situação de uma conta a pagar ou a receber.
enum SituacaoConta {
  ABERTA
  PAGA
  CANCELADA
}

// Módulo 5 — o RF019 pede relatório "por tipo de equipamento", e até aqui só
// existiam marca e modelo. "Dell Inspiron" e "Dell PowerEdge" são notebook e
// servidor, mas o banco não tinha como saber.
enum TipoEquipamento {
  NOTEBOOK
  DESKTOP
  IMPRESSORA
  SERVIDOR
  CELULAR
  OUTRO
}

// NF005 — rastreabilidade. LEITURA existe no catálogo porque o requisito a
// prevê, mas o registro automático cobre só as operações de escrita: logar toda
// consulta multiplicaria o volume do log por ordens de grandeza sem acrescentar
// rastreabilidade de quem alterou o quê.
enum AcaoAuditoria {
  LEITURA
  INCLUSAO
  ALTERACAO
  EXCLUSAO
}

// Módulo 6 — rastreamento de entregas. O estado da entrega vive nestas
// tabelas, e não no StatusOS: mexer no enum da OS afetaria relatórios,
// dashboards e testes que já funcionam.
enum StatusSaida {
  EM_ROTA
  CONCLUIDA
  CANCELADA
}

enum StatusEntrega {
  PENDENTE
  ENTREGUE
  NAO_ENTREGUE
}

model Usuario {
  id                 Int                @id @default(autoincrement())
  nome               String             @db.VarChar(150)
  login              String             @unique @db.VarChar(100)
  senha              String             @db.VarChar(255)
  ativo              Boolean            @default(true)
  perfilId           Int
  perfil             Perfil             @relation(fields: [perfilId], references: [id])
  criadoEm           DateTime           @default(now())
  ordens             OrdemServico[]
  // Módulo 4: rastreabilidade de estoque e financeiro
  movimentos         MovimentoEstoque[]
  contasPagas        ContaPagar[]
  contasRecebidas    ContaReceber[]
  // NF005
  logsAuditoria      LogAuditoria[]
  // Backlog item 2: serviços que este usuário executou (RN09)
  servicosExecutados ServicoExecutado[]
  // Módulo 6: saídas em que este usuário foi o entregador
  saidasEntrega      SaidaEntrega[]

  @@map("usuarios")
}

model Perfil {
  id         Int    @id @default(autoincrement())
  // Único: sem esta restrição o banco aceitava dois perfis ADMINISTRADOR, e com
  // perfil duplicado parte dos usuários aponta para um e parte para o outro —
  // o controle de acesso fica imprevisível. O seed se protegia no código, mas
  // nada impedia a duplicata por outro caminho.
  nomePerfil String @unique @db.VarChar(50)

  usuarios Usuario[]

  @@map("perfis")
}

model Cliente {
  id             Int            @id @default(autoincrement())
  nome           String         @db.VarChar(150)
  cpfCnpj        String         @unique @db.VarChar(18)
  rg             String?        @db.VarChar(20)
  dataNascimento DateTime?
  endereco       String?        @db.VarChar(200)
  numero         String?        @db.VarChar(10)
  bairro         String?        @db.VarChar(100)
  cidade         String?        @db.VarChar(100)
  estado         String?        @db.Char(2)
  cep            String?        @db.VarChar(9)
  telefone       String?        @db.VarChar(20)
  celular        String?        @db.VarChar(20)
  email          String?        @db.VarChar(150)
  ativo          Boolean        @default(true)
  // NF008 — quando os dados pessoais foram apagados a pedido do titular
  // (art. 18 da LGPD). Nulo = cliente com dados íntegros. O campo existe para
  // que a anonimização seja verificável: sem ele, só daria para adivinhar pelo
  // formato do cpfCnpj.
  anonimizadoEm  DateTime?
  criadoEm       DateTime       @default(now())
  equipamentos   Equipamento[]
  contasReceber  ContaReceber[]

  @@map("clientes")
}

model Equipamento {
  id          Int             @id @default(autoincrement())
  codigo      String          @unique @db.VarChar(50)
  // Default OUTRO para os equipamentos já cadastrados não quebrarem: eles
  // aparecem como "Outro" no relatório até serem reclassificados.
  tipo        TipoEquipamento @default(OUTRO)
  marca       String          @db.VarChar(100)
  modelo      String          @db.VarChar(100)
  numeroSerie String?         @db.VarChar(100)
  defeito     String          @db.Text
  // NF008 — exclusão lógica. Era a única tabela de cadastro sem ela: um
  // equipamento cadastrado por engano, ou que o cliente não traz mais, não
  // tinha como sair da lista. Exclusão física é impossível aqui, porque as
  // ordens de serviço apontam para ele com ON DELETE RESTRICT.
  ativo       Boolean         @default(true)
  clienteId   Int
  cliente     Cliente         @relation(fields: [clienteId], references: [id])
  ordens      OrdemServico[]
  criadoEm    DateTime        @default(now())

  @@map("equipamentos")
}

model OrdemServico {
  id              Int                @id @default(autoincrement())
  numero          String             @unique @db.VarChar(20)
  status          StatusOS           @default(INICIAL)
  defeitoRelatado String             @db.Text
  observacoes     String?            @db.Text
  valorOrcamento  Decimal?           @db.Decimal(10, 2)
  dataAprovacao   DateTime?
  previsaoEntrega DateTime?
  dataAbertura    DateTime           @default(now())
  dataFechamento  DateTime?
  equipamentoId   Int
  equipamento     Equipamento        @relation(fields: [equipamentoId], references: [id])
  usuarioId       Int
  usuario         Usuario            @relation(fields: [usuarioId], references: [id])
  servicos        ServicoExecutado[]
  itens           ItemOrdem[]
  contaReceber    ContaReceber?
  // Módulo 6: vezes em que a OS saiu para entrega
  entregas        EntregaOS[]

  @@map("ordens_servico")
}

model ServicoExecutado {
  id            Int          @id @default(autoincrement())
  // `descricao` continua sendo o relato do técnico, em texto livre.
  // `tipoServicoId` é o que permite AGRUPAR (RF017): sem ele, "Troca de tela",
  // "troca da tela" e "Substituição da tela" viram três serviços distintos.
  // Opcional porque os serviços registrados antes do catálogo não têm tipo —
  // eles aparecem como "Não classificado" no relatório.
  descricao     String       @db.Text
  observacoes   String?      @db.Text
  garantiaDias  Int?
  executadoEm   DateTime     @default(now())
  ordemId       Int
  ordem         OrdemServico @relation(fields: [ordemId], references: [id])
  tipoServicoId Int?
  tipoServico   TipoServico? @relation(fields: [tipoServicoId], references: [id])
  // Quem executou: o usuário logado que registrou o serviço (RN09). Opcional
  // porque os serviços anteriores a esta coluna não têm o dado — atribuir um
  // técnico a eles seria inventar.
  usuarioId     Int?
  usuario       Usuario?     @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  // Peças usadas neste serviço (RN10).
  itens         ItemOrdem[]

  @@index([usuarioId])
  @@map("servicos_executados")
}

// Módulo 5 — catálogo de serviços, a granularidade do RF017.
model TipoServico {
  id       Int                @id @default(autoincrement())
  nome     String             @unique @db.VarChar(120)
  ativo    Boolean            @default(true)
  criadoEm DateTime           @default(now())
  servicos ServicoExecutado[]

  @@map("tipos_servico")
}

model Produto {
  id         Int                @id @default(autoincrement())
  nome       String             @db.VarChar(150)
  descricao  String?            @db.Text
  preco      Decimal            @db.Decimal(10, 2)
  estoque    Int                @default(0)
  ativo      Boolean            @default(true)
  criadoEm   DateTime           @default(now())
  itens      ItemOrdem[]
  movimentos MovimentoEstoque[]

  @@map("produtos")
}

model ItemOrdem {
  id         Int               @id @default(autoincrement())
  quantidade Int
  valorUnit  Decimal           @db.Decimal(10, 2)
  // Módulo 5: a peça não tinha data própria. Sem isso, "produtos mais vendidos
  // por período" (RF018) teria que usar a data de abertura da OS — uma OS
  // aberta em julho com peça lançada em agosto contaria como julho.
  criadoEm   DateTime          @default(now())
  ordemId    Int
  ordem      OrdemServico      @relation(fields: [ordemId], references: [id])
  produtoId  Int
  produto    Produto           @relation(fields: [produtoId], references: [id])
  // Serviço em que a peça foi usada (RN10). Opcional: há peça que é da OS
  // como um todo. Só pode apontar para serviço da mesma OS (RN11). Ao excluir
  // o serviço, o vínculo é desfeito pelo Prisma, dentro da transação, para que
  // a auditoria registre a alteração (RN12). O banco usa RESTRICT, e não SET
  // NULL: um caminho que esquecesse de desvincular falha, em vez de apagar o
  // vínculo calado e fora do log.
  servicoId  Int?
  servico    ServicoExecutado? @relation(fields: [servicoId], references: [id], onDelete: Restrict)

  @@index([servicoId])
  @@map("itens_ordem")
}

model MovimentoEstoque {
  id         Int      @id @default(autoincrement())
  tipo       String   @db.VarChar(10)
  quantidade Int
  descricao  String?  @db.VarChar(200)
  produtoId  Int
  produto    Produto  @relation(fields: [produtoId], references: [id])
  // Quem registrou a movimentação. Opcional porque os movimentos gerados
  // automaticamente pela OS podem não ter um usuário na mão.
  usuarioId  Int?
  usuario    Usuario? @relation(fields: [usuarioId], references: [id])
  criadoEm   DateTime @default(now())

  @@map("movimentos_estoque")
}

// ===== Módulo 4 (parte 2) — Controle Financeiro (RF020 / RF021) =====

model ContaPagar {
  id           Int           @id @default(autoincrement())
  descricao    String        @db.VarChar(200)
  fornecedor   String?       @db.VarChar(150)
  valor        Decimal       @db.Decimal(10, 2)
  vencimento   DateTime
  situacao     SituacaoConta @default(ABERTA)
  quitadaEm    DateTime?
  observacoes  String?       @db.Text
  criadoEm     DateTime      @default(now())
  // Quem deu baixa no pagamento (RF023 — rastreabilidade)
  quitadaPorId Int?
  quitadaPor   Usuario?      @relation(fields: [quitadaPorId], references: [id])

  @@map("contas_pagar")
}

model ContaReceber {
  id           Int           @id @default(autoincrement())
  descricao    String        @db.VarChar(200)
  valor        Decimal       @db.Decimal(10, 2)
  vencimento   DateTime
  situacao     SituacaoConta @default(ABERTA)
  quitadaEm    DateTime?
  observacoes  String?       @db.Text
  criadoEm     DateTime      @default(now())
  // Vínculo opcional com a OS: preenchido quando a conta é gerada
  // automaticamente no encerramento. @unique garante uma conta por OS.
  ordemId      Int?          @unique
  ordem        OrdemServico? @relation(fields: [ordemId], references: [id])
  clienteId    Int?
  cliente      Cliente?      @relation(fields: [clienteId], references: [id])
  // Quem registrou o recebimento (RF023 — rastreabilidade)
  quitadaPorId Int?
  quitadaPor   Usuario?      @relation(fields: [quitadaPorId], references: [id])

  @@map("contas_receber")
}

// ===== NF005 — Rastreabilidade (log de auditoria) =====

model LogAuditoria {
  id            Int           @id @default(autoincrement())
  entidade      String        @db.VarChar(60)
  // Nulo quando a operação não atinge um registro único (p. ex. updateMany).
  registroId    Int?
  acao          AcaoAuditoria
  // Estado antes e depois, em JSON. Campos sensíveis como `senha` nunca entram:
  // o log registra QUE a senha mudou, nunca o valor.
  valorAnterior String?       @db.Text
  valorNovo     String?       @db.Text
  // 45 caracteres acomodam IPv6.
  ip            String?       @db.VarChar(45)
  // Opcional e SET NULL: o log precisa sobreviver à remoção do usuário. Também
  // é nulo nas operações sem sessão, como o seed.
  usuarioId     Int?
  usuario       Usuario?      @relation(fields: [usuarioId], references: [id])
  criadoEm      DateTime      @default(now())

  @@index([criadoEm])
  @@index([entidade, registroId])
  @@index([usuarioId])
  @@map("logs_auditoria")
}

// =============================================================================
// Módulo 6 — rastreamento de entregas
// =============================================================================

// Uma viagem do entregador, levando uma ou mais OS finalizadas.
model SaidaEntrega {
  id           Int              @id @default(autoincrement())
  status       StatusSaida      @default(EM_ROTA)
  // RN13: só existe uma saída em rota por vez. `true` enquanto EM_ROTA e
  // `null` depois — o índice único aceita vários nulos, então o próprio banco
  // recusa a segunda saída em rota, mesmo com dois cliques simultâneos.
  emRota       Boolean?         @unique @default(true)
  iniciadaEm   DateTime         @default(now())
  // Fim da saída, concluída ou cancelada.
  encerradaEm  DateTime?
  entregadorId Int
  entregador   Usuario          @relation(fields: [entregadorId], references: [id], onDelete: Restrict)
  entregas     EntregaOS[]
  posicoes     PosicaoEntrega[]

  @@index([entregadorId])
  @@map("saidas_entrega")
}

// Uma OS dentro da saída: uma parada do trajeto.
model EntregaOS {
  id              Int           @id @default(autoincrement())
  ordemParada     Int
  status          StatusEntrega @default(PENDENTE)
  // RN14: uma OS não pode estar em duas entregas pendentes. Recebe o ordemId
  // enquanto PENDENTE e `null` depois; o índice único faz o banco garantir.
  ordemPendenteId Int?          @unique
  // Coordenadas do destino, geocodificadas uma vez. Nulas quando a
  // geocodificação falha: a entrega segue sem o pino de destino.
  destinoLat      Decimal?      @db.Decimal(9, 6)
  destinoLng      Decimal?      @db.Decimal(9, 6)
  // SHA-256 do token de rastreio, nunca o token: ele dá acesso à posição do
  // entregador e não pode vazar num backup do banco.
  tokenHash       String?       @unique @db.VarChar(64)
  // Por que não foi entregue (cliente ausente, endereço errado...).
  motivo          String?       @db.VarChar(200)
  entregueEm      DateTime?
  saidaId         Int
  saida           SaidaEntrega  @relation(fields: [saidaId], references: [id], onDelete: Restrict)
  ordemId         Int
  ordem           OrdemServico  @relation(fields: [ordemId], references: [id], onDelete: Restrict)

  @@unique([saidaId, ordemId])
  @@index([ordemId])
  @@map("entregas_os")
}

// Posição do entregador durante a saída. Uma a cada ~10 s: fica fora da
// auditoria (só os eventos da saída são auditados) e tem retenção própria.
model PosicaoEntrega {
  id           Int          @id @default(autoincrement())
  lat          Decimal      @db.Decimal(9, 6)
  lng          Decimal      @db.Decimal(9, 6)
  precisao     Float?
  registradaEm DateTime     @default(now())
  saidaId      Int
  saida        SaidaEntrega @relation(fields: [saidaId], references: [id], onDelete: Restrict)

  @@index([saidaId, registradaEm])
  @@map("posicoes_entrega")
}

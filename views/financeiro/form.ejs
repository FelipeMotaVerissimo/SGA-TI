<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %> — SGA TI</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="layout">
    <%- include('../partials/sidebar', { path: '/financeiro' }) %>

    <div class="conteudo">
      <a href="/financeiro" class="voltar">← Voltar</a>

      <div class="page-header">
        <h1><%= titulo %></h1>
        <p>
          <%= tipo === 'PAGAR'
              ? 'Despesas da assistência: fornecedores, aluguel, serviços contratados'
              : 'Valores a receber de clientes' %>
        </p>
      </div>

      <%- include('../partials/alertas') %>

      <div class="form-box">
        <form action="<%= conta && conta.id ? `/financeiro/${rota}/${conta.id}/editar` : `/financeiro/${rota}` %>" method="POST">
          <%- include('../partials/csrf') %>

          <div class="form-row full">
            <div class="form-group">
              <label>Descrição *</label>
              <input type="text" name="descricao" maxlength="200" required
                placeholder="<%= tipo === 'PAGAR' ? 'Ex.: Compra de peças — NF 1234' : 'Ex.: Serviço avulso de formatação' %>"
                value="<%= conta ? (conta.descricao || '') : '' %>">
            </div>
          </div>

          <% if (tipo === 'PAGAR' && (!conta || !conta.id)) { %>
          <div class="form-row">
            <div class="form-group">
              <label>Valor por Unidade (R$) <span style="font-weight:normal; color:#888">(opcional)</span></label>
              <input type="text" id="pagar-valor-unitario" name="valorUnitario" placeholder="0,00"
                value="<%= conta ? (conta.valorUnitario || '') : '' %>">
            </div>
            <div class="form-group">
              <label>Quantidade de Unidades</label>
              <input type="number" id="pagar-quantidade" name="quantidade" min="1" max="99999" step="1"
                value="<%= conta && conta.quantidade ? conta.quantidade : '1' %>">
            </div>
          </div>
          <% } %>

          <div class="form-row">
            <div class="form-group">
              <label>Valor Total (R$) *</label>
              <input type="text" id="pagar-valor-total" name="valor" placeholder="0,00" required
                value="<%= conta ? (conta.valor || '') : '' %>">
              <small id="pagar-resumo-parcela" style="color:#185FA5; display:block; margin-top:4px"></small>
            </div>
            <div class="form-group">
              <label><%= tipo === 'PAGAR' && (!conta || !conta.id) ? '1º Vencimento *' : 'Vencimento *' %></label>
              <input type="date" name="vencimento" required
                value="<%= conta ? (conta.vencimento || '') : '' %>">
            </div>
          </div>

          <% if (tipo === 'PAGAR' && (!conta || !conta.id)) { %>
          <div class="form-row full">
            <div class="form-group">
              <label>Parcelamento</label>
              <select id="pagar-parcelas" name="parcelas">
                <option value="1" selected>À vista (1x)</option>
                <% for (let p = 2; p <= 24; p++) { %>
                <option value="<%= p %>" <%= conta && String(conta.parcelas) === String(p) ? 'selected' : '' %>>
                  <%= p %>x mensais
                </option>
                <% } %>
              </select>
            </div>
          </div>
          <% } %>

          <div class="form-row full">
            <% if (tipo === 'PAGAR') { %>
            <div class="form-group">
              <label>Fornecedor</label>
              <input type="text" name="fornecedor" maxlength="150" placeholder="Nome do fornecedor"
                value="<%= conta ? (conta.fornecedor || '') : '' %>">
            </div>
            <% } else { %>
            <div class="form-group">
              <label>Cliente</label>
              <select name="clienteId">
                <option value="">Sem vínculo com cliente</option>
                <% clientes.forEach(c => { %>
                <option value="<%= c.id %>"
                  <%= conta && String(conta.clienteId) === String(c.id) ? 'selected' : '' %>>
                  <%= c.nome %>
                </option>
                <% }) %>
              </select>
            </div>
            <% } %>
          </div>

          <div class="form-row full">
            <div class="form-group">
              <label>Observações</label>
              <textarea name="observacoes"><%= conta ? (conta.observacoes || '') : '' %></textarea>
            </div>
          </div>

          <div class="form-acoes">
            <button type="submit" class="btn btn-primary">💾 Salvar Conta</button>
            <a href="/financeiro" class="btn btn-secondary">✕ Cancelar</a>
          </div>

        </form>
      </div>
    </div>
  </div>
  <script src="/js/financeiro.js" defer></script>
</body>
</html>
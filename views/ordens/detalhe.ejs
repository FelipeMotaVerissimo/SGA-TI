<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %> — SGA TI</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="layout">
    <%- include('../partials/sidebar', { path: '/ordens' }) %>

    <div class="conteudo">
      <a href="/ordens" class="voltar">← Voltar</a>

      <div class="page-header">
        <h1><%= ordem.numero %></h1>
        <p>Detalhes da Ordem de Serviço</p>
      </div>

      <%- include('../partials/alertas') %>

      <!-- Status e ações -->
      <div class="form-box" style="margin-bottom:16px">
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px">
          <div>
            <span style="font-size:13px; color:#888">Status atual:</span><br>
            <span class="badge badge-azul" style="font-size:14px; padding:6px 14px">
              <%= ordem.status.replace('_',' ') %>
            </span>
          </div>
          <form action="/ordens/<%= ordem.id %>/status" method="POST" style="display:flex; gap:8px; align-items:center">
            <select name="status" class="form-group" style="padding:8px 12px; border:1px solid #ddd; border-radius:6px; font-size:14px">
              <% ['INICIAL','ORCAMENTO','AUTORIZADO','EM_ANDAMENTO','CANCELADO','FINALIZADO'].forEach(s => { %>
              <option value="<%= s %>" <%= ordem.status === s ? 'selected' : '' %>><%= s.replace('_',' ') %></option>
              <% }) %>
            </select>
            <button type="submit" class="btn btn-primary btn-sm">Atualizar Status</button>
          </form>
        </div>
      </div>

      <!-- Informações gerais -->
      <div class="form-box" style="margin-bottom:16px">
        <h2 style="font-size:15px; font-weight:600; margin-bottom:16px; color:#185FA5">📋 Informações Gerais</h2>
        <div class="form-row">
          <div class="form-group">
            <label>Cliente</label>
            <input type="text" value="<%= ordem.equipamento.cliente.nome %>" disabled>
          </div>
          <div class="form-group">
            <label>CPF/CNPJ</label>
            <input type="text" value="<%= ordem.equipamento.cliente.cpfCnpj %>" disabled>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Equipamento</label>
            <input type="text" value="<%= ordem.equipamento.marca %> <%= ordem.equipamento.modelo %>" disabled>
          </div>
          <div class="form-group">
            <label>Código</label>
            <input type="text" value="<%= ordem.equipamento.codigo %>" disabled>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Data de Abertura</label>
            <input type="text" value="<%= new Date(ordem.dataAbertura).toLocaleDateString('pt-BR') %>" disabled>
          </div>
          <div class="form-group">
            <label>Responsável</label>
            <input type="text" value="<%= ordem.usuario.nome %>" disabled>
          </div>
        </div>
        <div class="form-row full">
          <div class="form-group">
            <label>Defeito Relatado</label>
            <textarea disabled><%= ordem.defeitoRelatado %></textarea>
          </div>
        </div>
        <% if (ordem.observacoes) { %>
        <div class="form-row full">
          <div class="form-group">
            <label>Observações</label>
            <textarea disabled><%= ordem.observacoes %></textarea>
          </div>
        </div>
        <% } %>
      </div>

<!-- Orçamento -->
<div class="form-box" style="margin-bottom:16px">
  <h2 style="font-size:15px; font-weight:600; margin-bottom:16px; color:#185FA5">💰 Orçamento</h2>

  <form action="/ordens/<%= ordem.id %>/orcamento" method="POST">
    <div class="form-row">
      <div class="form-group">
        <label>Valor do Orçamento (R$)</label>
        <input type="number" step="0.01" name="valorOrcamento" placeholder="0,00"
          value="<%= ordem.valorOrcamento || '' %>">
      </div>
      <div class="form-group">
        <label>Previsão de Entrega</label>
        <input type="date" name="previsaoEntrega"
          value="<%= ordem.previsaoEntrega ? new Date(ordem.previsaoEntrega).toISOString().split('T')[0] : '' %>">
      </div>
    </div>
    <button type="submit" class="btn btn-primary btn-sm">💾 Salvar Orçamento</button>
  </form>

  <% if (ordem.valorOrcamento && ordem.status === 'ORCAMENTO') { %>
  <div style="margin-top:16px; padding-top:16px; border-top:1px solid #eee">
    <p style="font-size:13px; color:#555; margin-bottom:12px">
      Valor: <strong>R$ <%= Number(ordem.valorOrcamento).toFixed(2) %></strong>
      <% if (ordem.previsaoEntrega) { %>
        — Previsão: <strong><%= new Date(ordem.previsaoEntrega).toLocaleDateString('pt-BR') %></strong>
      <% } %>
    </p>
    <div style="display:flex; gap:12px">
      <form action="/ordens/<%= ordem.id %>/aprovar" method="POST">
        <button type="submit" class="btn btn-success btn-sm"
          onclick="return confirm('Confirmar aprovação do orçamento?')">
          ✅ Aprovar Orçamento
        </button>
      </form>
      <form action="/ordens/<%= ordem.id %>/rejeitar" method="POST">
        <button type="submit" class="btn btn-danger btn-sm"
          onclick="return confirm('Confirmar rejeição do orçamento?')">
          ❌ Rejeitar Orçamento
        </button>
      </form>
    </div>
  </div>
  <% } %>

  <% if (ordem.status === 'AUTORIZADO') { %>
  <div style="margin-top:16px; padding:12px; background:#f0fff4; border-radius:6px; border:1px solid #9ae6b4">
    <p style="color:#276749; font-size:13px">
      ✅ Orçamento aprovado em <strong><%= ordem.dataAprovacao ? new Date(ordem.dataAprovacao).toLocaleDateString('pt-BR') : '—' %></strong>
      — Valor: <strong>R$ <%= Number(ordem.valorOrcamento).toFixed(2) %></strong>
    </p>
  </div>
  <% } %>

  <% if (ordem.status === 'CANCELADO') { %>
  <div style="margin-top:16px; padding:12px; background:#fff5f5; border-radius:6px; border:1px solid #feb2b2">
    <p style="color:#c53030; font-size:13px">
      ❌ Orçamento rejeitado — OS cancelada.
    </p>
  </div>
  <% } %>

</div>

      <!-- Produtos utilizados -->
      <div class="tabela-box">
        <div class="tabela-header">
          <h2>📦 Produtos Utilizados</h2>
        </div>
        <table>
          <thead>
            <tr>
              <th>Produto</th>
              <th>Quantidade</th>
              <th>Valor Unit.</th>
              <th>Subtotal</th>
            </tr>
          </thead>
          <tbody>
            <% if (ordem.itens.length === 0) { %>
            <tr>
              <td colspan="4" style="text-align:center; color:#aaa; padding:24px">
                Nenhum produto utilizado ainda.
              </td>
            </tr>
            <% } else { %>
            <% ordem.itens.forEach(i => { %>
            <tr>
              <td><%= i.produto.nome %></td>
              <td><%= i.quantidade %></td>
              <td>R$ <%= Number(i.valorUnit).toFixed(2) %></td>
              <td>R$ <%= (Number(i.valorUnit) * i.quantidade).toFixed(2) %></td>
            </tr>
            <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>

    </div>
  </div>
</body>
</html>
<%
  // Módulo 4: a tela só mostra a ação que o perfil pode executar. Sem isso o
  // usuário preenche o formulário, leva "acesso negado" e perde o que digitou.
  const pode = (...perfis) => locals.temPermissao
    ? locals.temPermissao(locals.usuario, perfis)
    : true;

  const podeMexerStatus    = pode('TECNICO');
  const podeMexerOrcamento = pode('VENDEDOR');
  const podeAprovar        = pode('ATENDENTE', 'VENDEDOR');
  const podeMexerServico   = pode('TECNICO');
  const podeMexerItem      = pode('VENDEDOR');
  // Liberação de faturamento é da Gerência/ADM (entrevista, item 8).
  const podeFaturar        = pode();

  // A coluna "Ações" só aparece quando o status permite E o perfil pode.
  const mostrarAcoesServico = podeExcluirServico && podeMexerServico;
  const mostrarAcoesItem    = podeRemoverItem    && podeMexerItem;
%>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %> — SGA TI</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="layout">
    <%- include('../partials/sidebar', { path: '/ordens' }) %>

    <div class="conteudo">
      <a href="/ordens" class="voltar">← Voltar</a>

      <div class="page-header">
        <h1><%= ordem.numero %></h1>
        <p>Detalhes da Ordem de Serviço</p>
      </div>

      <%- include('../partials/alertas') %>

      <!-- Status e ações -->
      <div class="form-box" style="margin-bottom:16px">
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px">
          <div>
            <span style="font-size:13px; color:#888">Status atual:</span><br>
            <span class="badge badge-azul" style="font-size:14px; padding:6px 14px">
              <%= ordem.status.replace('_',' ') %>
            </span>
          </div>
          <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap">
            <% if (podeMexerStatus) { %>
            <form action="/ordens/<%= ordem.id %>/status" method="POST" style="display:flex; gap:8px; align-items:center">
              <select name="status" class="form-group" style="padding:8px 12px; border:1px solid #ddd; border-radius:6px; font-size:14px">
                <%# FINALIZADO fica de fora: encerrar é faturar, e depende de liberação da gerência %>
                <% ['INICIAL','ORCAMENTO','AUTORIZADO','EM_ANDAMENTO','CANCELADO'].forEach(s => { %>
                <option value="<%= s %>" <%= ordem.status === s ? 'selected' : '' %>><%= s.replace('_',' ') %></option>
                <% }) %>
              </select>
              <button type="submit" class="btn btn-primary btn-sm">Atualizar Status</button>
            </form>
            <% } %>

            <% if (podeFaturar && ordem.status === 'EM_ANDAMENTO') { %>
            <form action="/ordens/<%= ordem.id %>/faturar" method="POST">
              <button type="submit" class="btn btn-success btn-sm"
                onclick="return confirm('Faturar e encerrar esta OS? A conta a receber será gerada no financeiro.')">
                💵 Faturar e Encerrar
              </button>
            </form>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Informações gerais -->
      <div class="form-box" style="margin-bottom:16px">
        <h2 style="font-size:15px; font-weight:600; margin-bottom:16px; color:#185FA5">📋 Informações Gerais</h2>
        <div class="form-row">
          <div class="form-group">
            <label>Cliente</label>
            <input type="text" value="<%= ordem.equipamento.cliente.nome %>" disabled>
          </div>
          <div class="form-group">
            <label>CPF/CNPJ</label>
            <input type="text" value="<%= ordem.equipamento.cliente.cpfCnpj %>" disabled>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Equipamento</label>
            <input type="text" value="<%= ordem.equipamento.marca %> <%= ordem.equipamento.modelo %>" disabled>
          </div>
          <div class="form-group">
            <label>Código</label>
            <input type="text" value="<%= ordem.equipamento.codigo %>" disabled>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Data de Abertura</label>
            <input type="text" value="<%= new Date(ordem.dataAbertura).toLocaleDateString('pt-BR') %>" disabled>
          </div>
          <div class="form-group">
            <label>Responsável</label>
            <input type="text" value="<%= ordem.usuario.nome %>" disabled>
          </div>
        </div>
        <div class="form-row full">
          <div class="form-group">
            <label>Defeito Relatado</label>
            <textarea disabled><%= ordem.defeitoRelatado %></textarea>
          </div>
        </div>
        <% if (ordem.observacoes) { %>
        <div class="form-row full">
          <div class="form-group">
            <label>Observações</label>
            <textarea disabled><%= ordem.observacoes %></textarea>
          </div>
        </div>
        <% } %>
      </div>

<!-- Orçamento -->
<div class="form-box" style="margin-bottom:16px">
  <h2 style="font-size:15px; font-weight:600; margin-bottom:16px; color:#185FA5">💰 Orçamento</h2>

  <% if (podeEditarOrcamento && podeMexerOrcamento) { %>
  <form action="/ordens/<%= ordem.id %>/orcamento" method="POST">
    <div class="form-row">
      <div class="form-group">
        <label>Valor do Orçamento (R$) *</label>
        <input type="number" step="0.01" min="0.01" name="valorOrcamento" placeholder="0,00" required
          value="<%= ordem.valorOrcamento || '' %>">
      </div>
      <div class="form-group">
        <label>Previsão de Entrega</label>
        <input type="date" name="previsaoEntrega"
          value="<%= ordem.previsaoEntrega ? formatarDataInput(ordem.previsaoEntrega) : '' %>">
      </div>
    </div>
    <button type="submit" class="btn btn-primary btn-sm">💾 Salvar Orçamento</button>
  </form>
  <% } else if (!ordem.valorOrcamento) { %>
  <p style="font-size:13px; color:#888">
    Nenhum orçamento registrado.
    <% if (podeEditarOrcamento) { %>
      O lançamento do orçamento é atribuição do VENDEDOR.
    <% } else { %>
      O orçamento só pode ser lançado enquanto a OS estiver
      <strong>INICIAL</strong> ou <strong>ORCAMENTO</strong>.
    <% } %>
  </p>
  <% } else if (ordem.status !== 'AUTORIZADO') { %>
  <p style="font-size:13px; color:#555">
    Valor: <strong>R$ <%= Number(ordem.valorOrcamento).toFixed(2) %></strong>
    <% if (ordem.previsaoEntrega) { %>
      — Previsão de entrega: <strong><%= new Date(ordem.previsaoEntrega).toLocaleDateString('pt-BR') %></strong>
    <% } %>
    <% if (ordem.dataAprovacao) { %>
      — Aprovado em: <strong><%= new Date(ordem.dataAprovacao).toLocaleDateString('pt-BR') %></strong>
    <% } %>
  </p>
  <% } %>

  <% if (ordem.valorOrcamento && ordem.status === 'ORCAMENTO' && podeAprovar) { %>
  <div style="margin-top:16px; padding-top:16px; border-top:1px solid #eee">
    <%
      // O valor já aparece acima — no formulário, para quem lança o orçamento,
      // ou no resumo, para quem só acompanha. Repetir aqui duplicava a linha.
    %>
    <div style="display:flex; gap:12px">
      <form action="/ordens/<%= ordem.id %>/aprovar" method="POST">
        <button type="submit" class="btn btn-success btn-sm"
          onclick="return confirm('Confirmar aprovação do orçamento?')">
          ✅ Aprovar Orçamento
        </button>
      </form>
      <form action="/ordens/<%= ordem.id %>/rejeitar" method="POST">
        <button type="submit" class="btn btn-danger btn-sm"
          onclick="return confirm('Confirmar rejeição do orçamento?')">
          ❌ Rejeitar Orçamento
        </button>
      </form>
    </div>
  </div>
  <% } %>

  <% if (ordem.status === 'AUTORIZADO') { %>
  <div style="margin-top:16px; padding:12px; background:#f0fff4; border-radius:6px; border:1px solid #9ae6b4">
    <p style="color:#276749; font-size:13px">
      ✅ Orçamento aprovado em <strong><%= ordem.dataAprovacao ? new Date(ordem.dataAprovacao).toLocaleDateString('pt-BR') : '—' %></strong>
      — Valor: <strong>R$ <%= Number(ordem.valorOrcamento).toFixed(2) %></strong>
      <% if (ordem.previsaoEntrega) { %>
        — Previsão de entrega: <strong><%= new Date(ordem.previsaoEntrega).toLocaleDateString('pt-BR') %></strong>
      <% } %>
    </p>
  </div>
  <% } %>

  <% if (ordem.status === 'CANCELADO') { %>
  <div style="margin-top:16px; padding:12px; background:#fff5f5; border-radius:6px; border:1px solid #feb2b2">
    <p style="color:#c53030; font-size:13px">
      ❌ Orçamento rejeitado — OS cancelada.
    </p>
  </div>
  <% } %>

</div>

      <!-- ============================================================ -->
      <!-- Módulo 3 (parte 2) — Serviços Executados e Garantia          -->
      <!-- ============================================================ -->
      <div class="form-box" style="margin-bottom:16px">
        <h2 style="font-size:15px; font-weight:600; margin-bottom:16px; color:#185FA5">🔧 Registrar Serviço Executado</h2>

        <% if (podeRegistrarServico && podeMexerServico) { %>
        <form action="/ordens/<%= ordem.id %>/servicos" method="POST">
          <div class="form-row full">
            <div class="form-group">
              <label>Descrição do Serviço *</label>
              <textarea name="descricao" rows="3" required minlength="5"
                placeholder="Ex: Troca da placa-mãe e reaplicação de pasta térmica"></textarea>
            </div>
          </div>
          <div class="form-row full">
            <div class="form-group">
              <label>Observações</label>
              <textarea name="observacoes" rows="2"
                placeholder="Informações complementares (opcional)"></textarea>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>Garantia (dias)</label>
              <input type="number" name="garantiaDias" min="0" max="3650" step="1" placeholder="Ex: 90">
              <small style="color:#888; font-size:12px">Deixe em branco ou 0 para serviço sem garantia.</small>
            </div>
            <div class="form-group" style="display:flex; align-items:flex-end">
              <button type="submit" class="btn btn-success btn-sm">➕ Registrar Serviço</button>
            </div>
          </div>
        </form>
        <% } else if (!podeMexerServico) { %>
        <div style="padding:12px; background:#f7f9fc; border-radius:6px; border:1px solid #e2e8f0">
          <p style="color:#666; font-size:13px">
            O registro de serviços executados é atribuição do <strong>TÉCNICO</strong>.
          </p>
        </div>
        <% } else { %>
        <div style="padding:12px; background:#fffaf0; border-radius:6px; border:1px solid #fbd38d">
          <p style="color:#975a16; font-size:13px">
            ⚠️ Serviços só podem ser registrados quando a OS estiver com status
            <strong>AUTORIZADO</strong> ou <strong>EM ANDAMENTO</strong>.
            Status atual: <strong><%= ordem.status.replace('_',' ') %></strong>.
          </p>
        </div>
        <% } %>
      </div>

      <div class="tabela-box" style="margin-bottom:16px">
        <div class="tabela-header">
          <h2>🛠️ Serviços Executados</h2>
        </div>
        <table>
          <thead>
            <tr>
              <th>Descrição</th>
              <th>Observações</th>
              <th>Executado em</th>
              <th>Garantia</th>
              <th>Situação</th>
              <% if (mostrarAcoesServico) { %><th>Ações</th><% } %>
            </tr>
          </thead>
          <tbody>
            <% if (!servicos || servicos.length === 0) { %>
            <tr>
              <td colspan="<%= mostrarAcoesServico ? 6 : 5 %>" style="text-align:center; color:#aaa; padding:24px">
                Nenhum serviço executado registrado ainda.
              </td>
            </tr>
            <% } else { %>
            <% servicos.forEach(s => { %>
            <tr>
              <td><%= s.descricao %></td>
              <td style="color:#666"><%= s.observacoes || '—' %></td>
              <td><%= new Date(s.executadoEm).toLocaleDateString('pt-BR') %></td>
              <td>
                <% if (s.garantia.possuiGarantia) { %>
                  <%= s.garantiaDias %> dia(s)<br>
                  <span style="font-size:12px; color:#888">
                    até <%= s.garantia.dataFim.toLocaleDateString('pt-BR') %>
                  </span>
                <% } else { %>
                  <span style="color:#aaa">—</span>
                <% } %>
              </td>
              <td>
                <% if (s.garantia.situacao === 'EM_GARANTIA') { %>
                  <span class="badge" style="background:#f0fff4; color:#276749; border:1px solid #9ae6b4">
                    ✅ <%= s.garantia.diasRestantes %> dia(s)
                  </span>
                <% } else if (s.garantia.situacao === 'VENCIDA') { %>
                  <span class="badge" style="background:#fff5f5; color:#c53030; border:1px solid #feb2b2">
                    ⌛ Vencida
                  </span>
                <% } else { %>
                  <span class="badge" style="background:#f7f7f7; color:#777; border:1px solid #ddd">
                    Sem garantia
                  </span>
                <% } %>
              </td>
              <% if (mostrarAcoesServico) { %>
              <td>
                <form action="/ordens/<%= ordem.id %>/servicos/<%= s.id %>/excluir" method="POST">
                  <button type="submit" class="btn btn-danger btn-sm"
                    onclick="return confirm('Excluir este serviço executado?')">
                    🗑️ Excluir
                  </button>
                </form>
              </td>
              <% } %>
            </tr>
            <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
      <!-- ============ fim Módulo 3 (parte 2) ============ -->

      <!-- ============ Módulo 4 (parte 1): produtos utilizados ============ -->
      <!-- Produtos utilizados -->
      <% if (podeLancarItem && podeMexerItem) { %>
      <div class="form-box" style="margin-bottom:16px">
        <h2 style="font-size:15px; font-weight:600; margin-bottom:16px; color:#185FA5">📦 Lançar Produto na OS</h2>
        <form action="/ordens/<%= ordem.id %>/itens" method="POST">
          <div class="form-row">
            <div class="form-group">
              <label>Produto *</label>
              <select name="produtoId" required>
                <option value="">Selecione o produto</option>
                <% produtos.forEach(p => { %>
                <option value="<%= p.id %>" data-preco="<%= Number(p.preco).toFixed(2) %>">
                  <%= p.nome %> — R$ <%= Number(p.preco).toFixed(2) %> (<%= p.estoque %> em estoque)
                </option>
                <% }) %>
              </select>
            </div>
            <div class="form-group">
              <label>Quantidade *</label>
              <input type="number" name="quantidade" min="1" step="1" value="1" required>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>Valor Unitário (R$)</label>
              <input type="text" name="valorUnit" placeholder="Em branco = preço de tabela">
              <span style="font-size:12px; color:#888">
                Preencha apenas se houver desconto ou preço negociado.
              </span>
            </div>
          </div>
          <button type="submit" class="btn btn-primary btn-sm">➕ Lançar Produto</button>
        </form>
      </div>
      <% } else if (podeMexerItem) { %>
      <div class="alert alert-aviso" style="margin-bottom:16px">
        ⚠ Produtos só podem ser lançados quando a OS estiver <strong>AUTORIZADO</strong>
        ou <strong>EM ANDAMENTO</strong>. Status atual: <strong><%= ordem.status.replace('_',' ') %></strong>.
      </div>
      <% } %>

      <div class="tabela-box">
        <div class="tabela-header">
          <h2>📦 Produtos Utilizados</h2>
          <span style="font-size:13px; color:#555">
            Total em peças: <strong>R$ <%= totalItens.toFixed(2) %></strong>
          </span>
        </div>
        <table>
          <thead>
            <tr>
              <th>Produto</th>
              <th>Quantidade</th>
              <th>Valor Unit.</th>
              <th>Subtotal</th>
              <% if (mostrarAcoesItem) { %><th>Ações</th><% } %>
            </tr>
          </thead>
          <tbody>
            <% if (ordem.itens.length === 0) { %>
            <tr>
              <td colspan="<%= mostrarAcoesItem ? 5 : 4 %>" style="text-align:center; color:#aaa; padding:24px">
                Nenhum produto utilizado ainda.
              </td>
            </tr>
            <% } else { %>
            <% ordem.itens.forEach(i => { %>
            <tr>
              <td><%= i.produto.nome %></td>
              <td><%= i.quantidade %></td>
              <td>R$ <%= Number(i.valorUnit).toFixed(2) %></td>
              <td>R$ <%= (Number(i.valorUnit) * i.quantidade).toFixed(2) %></td>
              <% if (mostrarAcoesItem) { %>
              <td>
                <form action="/ordens/<%= ordem.id %>/itens/<%= i.id %>/remover" method="POST" style="display:inline"
                  onsubmit="return confirm('Remover este produto da OS? A quantidade volta para o estoque.')">
                  <button type="submit" class="btn btn-danger btn-sm">Remover</button>
                </form>
              </td>
              <% } %>
            </tr>
            <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
      <!-- ============ fim Módulo 4 (parte 1) ============ -->

    </div>
  </div>
</body>
</html>

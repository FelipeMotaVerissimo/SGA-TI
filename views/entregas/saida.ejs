<%
  // Módulo 6 — tela da saída de entrega, pensada primeiro para o celular.
  // O envio da posição (public/js/entregador.js) só liga para o entregador da
  // saída: o administrador vê a tela, mas não manda posição (RN19).
  const ehAdmin = locals.usuario && locals.usuario.perfil === 'ADMINISTRADOR';
  const souEntregador = ativa && locals.usuario && ativa.entregadorId === locals.usuario.id;
  const endereco = (c) => [
    [c.endereco, c.numero].filter(Boolean).join(', '),
    c.bairro,
    [c.cidade, c.estado].filter(Boolean).join('/'),
  ].filter(Boolean).join(' — ') || 'Endereço não cadastrado';
  // "Navegar" abre o app de mapas do celular. Com a coordenada geocodificada
  // vai direto ao ponto; sem ela, manda o endereço em texto.
  const linkNavegar = (e) => {
    const c = e.ordem.equipamento.cliente;
    const destino = e.destinoLat !== null && e.destinoLng !== null
      ? `${Number(e.destinoLat)},${Number(e.destinoLng)}`
      : [c.endereco, c.numero, c.bairro, c.cidade, c.estado].filter(Boolean).join(', ');
    return destino ? `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(destino)}` : null;
  };
  const rotulo = { PENDENTE: 'Pendente', ENTREGUE: 'Entregue', NAO_ENTREGUE: 'Não entregue' };
  const cor    = { PENDENTE: 'badge-amarelo', ENTREGUE: 'badge-verde', NAO_ENTREGUE: 'badge-vermelho' };
  const pendentes = ativa ? ativa.entregas.filter((e) => e.status === 'PENDENTE').length : 0;
%>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %> — SGA TI</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="layout">
    <%- include('../partials/sidebar', { path: '/entregas' }) %>

    <div class="conteudo">
      <div class="page-header">
        <h1>🚚 Saída de entrega</h1>
        <p>Leve as OS finalizadas e marque cada parada</p>
      </div>

      <%- include('../partials/alertas') %>

      <% if (ativa) { %>
      <div id="painel-gps" class="painel-gps" data-enviar="<%= souEntregador ? '1' : '0' %>">
        <% if (souEntregador) { %>
        <div class="gps-faixa gps-atencao">📍 Localização ainda não enviada</div>
        <div class="gps-aviso" hidden></div>
        <div class="gps-tela" hidden>Mantenha a tela acesa durante a entrega: com ela bloqueada, o celular para de enviar a localização.</div>
        <% } else { %>
        <div class="gps-faixa gps-info">Acompanhando a saída de <strong><%= ativa.entregador.nome %></strong> — a localização é enviada pelo celular dele.</div>
        <% } %>
      </div>

      <p class="saida-resumo">
        Em rota desde <%= new Date(ativa.iniciadaEm).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }) %> ·
        <strong><%= pendentes %></strong> de <%= ativa.entregas.length %> parada(s) pendente(s)
      </p>

      <div class="paradas">
        <% ativa.entregas.forEach(e => { const c = e.ordem.equipamento.cliente; const nav = linkNavegar(e); %>
        <div class="parada-cartao <%= e.status === 'PENDENTE' ? '' : 'parada-concluida' %>">
          <div class="parada-topo">
            <span class="parada-numero"><%= e.ordemParada %></span>
            <div class="parada-dados">
              <strong><%= c.nome %></strong>
              <span class="parada-endereco"><%= endereco(c) %></span>
              <span class="parada-os"><%= e.ordem.numero %></span>
            </div>
            <span class="badge <%= cor[e.status] %>"><%= rotulo[e.status] %></span>
          </div>
          <% if (e.motivo) { %><p class="parada-motivo"><%= e.motivo %></p><% } %>

          <% if (e.status === 'PENDENTE') { %>
          <div class="parada-acoes">
            <% if (nav) { %>
            <a href="<%= nav %>" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-grande">🧭 Navegar</a>
            <% } %>
            <form action="/entregas/<%= e.id %>/entregue" method="POST"
              data-confirmar="Confirmar a entrega da OS <%= e.ordem.numero %>?">
              <%- include('../partials/csrf') %>
              <button type="submit" class="btn btn-success btn-grande">✅ Entregue</button>
            </form>
          </div>
          <details class="parada-nao-entregue">
            <summary>Não entregue</summary>
            <form action="/entregas/<%= e.id %>/nao-entregue" method="POST">
              <%- include('../partials/csrf') %>
              <label for="motivo-<%= e.id %>">Motivo</label>
              <input type="text" id="motivo-<%= e.id %>" name="motivo" required minlength="3" maxlength="200"
                placeholder="Cliente ausente, endereço errado…">
              <button type="submit" class="btn btn-danger btn-grande">Registrar não entrega</button>
            </form>
          </details>
          <% } %>
        </div>
        <% }) %>
      </div>

      <div class="saida-fim">
        <form action="/entregas/saida/encerrar" method="POST"
          data-confirmar="Encerrar a saída? Todas as paradas precisam estar marcadas.">
          <%- include('../partials/csrf') %>
          <button type="submit" class="btn btn-primary btn-grande">🏁 Encerrar saída</button>
        </form>
        <% if (ehAdmin) { %>
        <form action="/entregas/saidas/<%= ativa.id %>/cancelar" method="POST"
          data-confirmar="Cancelar a saída? As entregas pendentes ficam como não entregues.">
          <%- include('../partials/csrf') %>
          <button type="submit" class="btn btn-danger btn-grande">Cancelar saída</button>
        </form>
        <% } %>
      </div>

      <% if (souEntregador) { %>
      <script src="/js/entregador.js" defer></script>
      <% } %>

      <% } else { %>
      <div class="form-box">
        <h2 class="secao-titulo">Iniciar saída</h2>
        <% if (elegiveis.length === 0) { %>
        <p class="texto-apagado">
          Nenhuma OS finalizada aguardando entrega nos últimos <%= diasElegivel %> dias.
        </p>
        <% } else { %>
        <form action="/entregas/saida" method="POST">
          <%- include('../partials/csrf') %>
          <div class="paradas">
            <% elegiveis.forEach(os => { const c = os.equipamento.cliente; %>
            <label class="parada-cartao parada-escolha" for="os-<%= os.id %>">
              <input type="checkbox" name="ordemIds" value="<%= os.id %>" id="os-<%= os.id %>">
              <div class="parada-dados">
                <strong><%= c.nome %></strong>
                <span class="parada-endereco"><%= endereco(c) %></span>
                <span class="parada-os"><%= os.numero %> · faturada em <%= os.dataFechamento ? new Date(os.dataFechamento).toLocaleDateString('pt-BR') : '—' %></span>
              </div>
            </label>
            <% }) %>
          </div>
          <button type="submit" class="btn btn-primary btn-grande">🚚 Iniciar saída</button>
        </form>
        <% } %>
      </div>
      <% } %>
    </div>
  </div>
</body>
</html>

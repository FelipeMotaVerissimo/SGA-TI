<%
  // Módulo 4: o menu mostra só o que o perfil do usuário pode acessar (RF023).
  // A mesma função usada pelo middleware das rotas, exposta em res.locals.
  const pode = (...perfis) => locals.temPermissao
    ? locals.temPermissao(locals.usuario, perfis)
    : true;
%>
<div class="sidebar">
  <div class="brand">
    <div>
      <h2>SGA TI</h2>
      <p>Sistema de Gestão</p>
    </div>
    <%# Só aparece abaixo de 768px — ver a seção de responsividade do style.css %>
    <button type="button" class="menu-toggle"
            aria-label="Abrir menu" aria-expanded="false" aria-controls="menu-principal">☰</button>
  </div>

  <nav id="menu-principal">
    <%# Módulo 6: o entregador vai direto para a saída; o dashboard não é para ele. %>
    <% if (!locals.usuario || locals.usuario.perfil !== 'ENTREGADOR') { %>
    <a href="/dashboard" class="<%= locals.path === '/dashboard' ? 'ativo' : '' %>">
      📊 Dashboard
    </a>
    <% } %>
    <% if (pode('ENTREGADOR')) { %>
    <%# O administrador abre o painel (/entregas); o entregador, a tela da saída. %>
    <a href="<%= locals.usuario && locals.usuario.perfil === 'ADMINISTRADOR' ? '/entregas' : '/entregas/saida' %>" class="<%= locals.path && locals.path.startsWith('/entregas') ? 'ativo' : '' %>">
      🚚 Entregas
    </a>
    <% } %>
    <% if (pode('ATENDENTE')) { %>
    <a href="/clientes" class="<%= locals.path && locals.path.startsWith('/clientes') ? 'ativo' : '' %>">
      👤 Clientes
    </a>
    <a href="/equipamentos" class="<%= locals.path && locals.path.startsWith('/equipamentos') ? 'ativo' : '' %>">
      🔧 Equipamentos
    </a>
    <% } %>
    <% if (pode('ATENDENTE', 'TECNICO', 'VENDEDOR')) { %>
    <a href="/ordens" class="<%= locals.path && locals.path.startsWith('/ordens') ? 'ativo' : '' %>">
      📋 Ordens de Serviço
    </a>
    <% } %>
    <% if (pode('COMPRAS', 'VENDEDOR')) { %>
    <a href="/produtos" class="<%= locals.path && locals.path.startsWith('/produtos') ? 'ativo' : '' %>">
      📦 Produtos
    </a>
    <% } %>
    <% if (pode('FINANCEIRO')) { %>
    <a href="/financeiro" class="<%= locals.path && locals.path.startsWith('/financeiro') ? 'ativo' : '' %>">
      💰 Financeiro
    </a>
    <% } %>
    <% if (pode()) { %>
    <a href="/relatorios" class="<%= locals.path && locals.path.startsWith('/relatorios') ? 'ativo' : '' %>">
      📈 Relatórios
    </a>
    <a href="/tipos-servico" class="<%= locals.path && locals.path.startsWith('/tipos-servico') ? 'ativo' : '' %>">
      🏷️ Tipos de Serviço
    </a>
    <a href="/auditoria" class="<%= locals.path && locals.path.startsWith('/auditoria') ? 'ativo' : '' %>">
      📜 Auditoria
    </a>
    <a href="/usuarios" class="<%= locals.path && locals.path.startsWith('/usuarios') ? 'ativo' : '' %>">
      ⚙️ Usuários
    </a>
    <% } %>
  </nav>

  <div class="user-info">
    <p><%= locals.usuario ? locals.usuario.nome : '' %></p>
    <span><%= locals.usuario ? locals.usuario.perfil : '' %></span><br>
    <%# POST com token: um link de outro site não consegue encerrar a sessão (NF007). %>
    <form action="/logout" method="POST" class="form-sair">
      <%- include('csrf') %>
      <button type="submit">↩ Sair</button>
    </form>
  </div>
</div>
<script src="/js/menu.js" defer></script>
<script src="/js/confirmar.js" defer></script>
